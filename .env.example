# =============================================================================
# Environment Variables - Copy this file to .env and fill in your values
# =============================================================================
# cp .env.example .env
# =============================================================================

# -----------------------------------------------------------------------------
# Required
# -----------------------------------------------------------------------------

# Get your free API key at https://the-odds-api.com (500 requests/month free)
ODDS_API_KEY=your_api_key_here

# Flask secret key for session security (generate a random string)
# You can generate one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_to_a_random_string

# -----------------------------------------------------------------------------
# Optional - Scheduler Settings
# -----------------------------------------------------------------------------

# Enable background job scheduler (set to "true" in production)
ENABLE_SCHEDULER=false

# Default fetch interval in minutes when no games are near
FETCH_INTERVAL_DEFAULT_MINUTES=60

# Hours before kickoff to switch to "near" interval
FETCH_INTERVAL_NEAR_HOURS=3

# Fetch interval when a game is within the "near" window
FETCH_INTERVAL_NEAR_MINUTES=15

# Hours before kickoff to switch to "imminent" interval
FETCH_INTERVAL_IMMINENT_HOURS=1

# Fetch interval when a game is within the "imminent" window
FETCH_INTERVAL_IMMINENT_MINUTES=5

# -----------------------------------------------------------------------------
# Optional - Detection Thresholds
# -----------------------------------------------------------------------------

# Minimum arbitrage profit percentage to flag (e.g., 1.0 = 1%)
ARB_THRESHOLD_PERCENT=1.0

# Minimum edge percentage to flag as a value bet
VALUE_THRESHOLD_PERCENT=3.0

# -----------------------------------------------------------------------------
# Optional - Steam Move Detection
# -----------------------------------------------------------------------------

# Time window in minutes to detect steam moves
STEAM_WINDOW_MINUTES=15

# Minimum number of books moving in same direction for a steam signal
STEAM_MIN_BOOKS=3

# Minimum odds movement (in American odds) to count as significant
STEAM_MIN_PRICE_MOVE=20

# Minimum point spread/total movement to count as significant
STEAM_MIN_POINT_MOVE=0.5

# -----------------------------------------------------------------------------
# Optional - Sports Configuration
# -----------------------------------------------------------------------------

# Comma-separated list of sports to track
# See https://the-odds-api.com/sports-odds-data/sports-apis.html for full list
SUPPORTED_SPORTS=americanfootball_nfl,basketball_nba

# -----------------------------------------------------------------------------
# Optional - Database (defaults to SQLite)
# -----------------------------------------------------------------------------

# For PostgreSQL: postgresql://user:password@localhost:5432/betting
# For SQLite (default): sqlite:///betting.db
# DATABASE_URL=sqlite:///betting.db
